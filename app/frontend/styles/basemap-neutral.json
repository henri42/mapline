{
  "version": 8,
  "name": "Mapline Neutral",
  "metadata": {
    "mapline:note": "Fond neutre dérivé d'OpenFreeMap Positron (schéma OpenMapTiles) : uniquement géographie physique (terre, eau, relief végétal). Aucune frontière, aucun toponyme, aucune route — pour ne pas plaquer le monde moderne sur des cartes historiques."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f3efe7" }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 8,
      "filter": ["all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["==", ["get", "class"], "wood"]
      ],
      "paint": {
        "fill-color": "#e5eadc",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0, 12, 0.5]
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "filter": ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
      "paint": { "fill-color": "#e7ecdf", "fill-opacity": 0.7 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "paint": { "fill-antialias": true, "fill-color": "#c6d7dd" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 6,
      "filter": ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
      "paint": {
        "line-color": "#c6d7dd",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 1.5]
      }
    }
  ]
}
