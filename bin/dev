#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

Dir.chdir(APP_ROOT) do
  begin
    exec "foreman", "start", "-f", "Procfile.dev", *ARGV
  rescue Errno::ENOENT
    puts "Installation de foreman…"
    system "gem install foreman"
    exec "foreman", "start", "-f", "Procfile.dev", *ARGV
  end
end
